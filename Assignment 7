#include <stdio.h>

struct Student {
    int roll;
    char name[50];
    int marks[3];
    int total;
    float percentage;
};

int main() {
    struct Student s[50];
    int n, i, j, pass;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of student %d\n", i + 1);
        printf("Roll No: ");
        scanf("%d", &s[i].roll);
        printf("Name: ");
        scanf(" %[^\n]", s[i].name);
        s[i].total = 0;
        for (j = 0; j < 3; j++) {
            printf("Marks in subject %d: ", j + 1);
            scanf("%d", &s[i].marks[j]);
            s[i].total += s[i].marks[j];
        }
        s[i].percentage = s[i].total / 3.0;
    }

    printf("\n%-6s %-20s %-6s %-6s %-6s %-6s %-8s %-6s\n",
           "Roll", "Name", "Sub1", "Sub2", "Sub3", "Total", "Per%", "Result");
    for (i = 0; i < n; i++) {
        pass = 1;
        for (j = 0; j < 3; j++)
            if (s[i].marks[j] < 40) pass = 0;

        printf("%-6d %-20s %-6d %-6d %-6d %-6d %-8.2f %-6s\n",
               s[i].roll, s[i].name, s[i].marks[0], s[i].marks[1],
               s[i].marks[2], s[i].total, s[i].percentage,
               pass ? "PASS" : "FAIL");
    }
    return 0;
}
