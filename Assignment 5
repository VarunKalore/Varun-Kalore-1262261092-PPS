#include <stdio.h>
#include <string.h>

int main() {
    char s1[100], s2[100], x, *p;
    int ch, i, n;
    char temp;

    do {
        printf("\n----- STRING MENU -----\n");
        printf("1. Length\n2. Copy\n3. Concatenate\n4. Compare\n");
        printf("5. Reverse\n6. Search character\n7. Search substring\n8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                printf("Enter string: "); scanf(" %[^\n]", s1);
                printf("Length = %lu\n", strlen(s1));
                break;
            case 2:
                printf("Enter string: "); scanf(" %[^\n]", s1);
                strcpy(s2, s1);
                printf("Copied string = %s\n", s2);
                break;
            case 3:
                printf("Enter first string: "); scanf(" %[^\n]", s1);
                printf("Enter second string: "); scanf(" %[^\n]", s2);
                strcat(s1, s2);
                printf("Concatenated string = %s\n", s1);
                break;
            case 4:
                printf("Enter first string: "); scanf(" %[^\n]", s1);
                printf("Enter second string: "); scanf(" %[^\n]", s2);
                if (strcmp(s1, s2) == 0) printf("Strings are equal\n");
                else printf("Strings are not equal\n");
                break;
            case 5:
                printf("Enter string: "); scanf(" %[^\n]", s1);
                n = strlen(s1);
                for (i = 0; i < n / 2; i++) {
                    temp = s1[i];
                    s1[i] = s1[n - 1 - i];
                    s1[n - 1 - i] = temp;
                }
                printf("Reversed string = %s\n", s1);
                break;
            case 6:
                printf("Enter string: "); scanf(" %[^\n]", s1);
                printf("Enter character: "); scanf(" %c", &x);
                p = strchr(s1, x);
                if (p != NULL) printf("'%c' found at position %ld\n", x, p - s1 + 1);
                else printf("Character not found\n");
                break;
            case 7:
                printf("Enter main string: "); scanf(" %[^\n]", s1);
                printf("Enter substring: "); scanf(" %[^\n]", s2);
                p = strstr(s1, s2);
                if (p != NULL) printf("Substring found at position %ld\n", p - s1 + 1);
                else printf("Substring not found\n");
                break;
            case 8: printf("Exiting...\n"); break;
            default: printf("Invalid choice!\n");
        }
    } while (ch != 8);

    return 0;
}
