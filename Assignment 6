#include <stdio.h>

/* Without recursion */
unsigned long long ifact(int n) {
    unsigned long long fact = 1;
    int i;
    for (i = 1; i <= n; i++)
        fact = fact * i;
    return fact;
}

/* With recursion */
unsigned long long rfact(int n) {
    if (n == 0 || n == 1)
        return 1;
    return n * rfact(n - 1);
}

int main() {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Factorial is not defined for negative numbers\n");
    } else {
        printf("Factorial without recursion = %llu\n", ifact(n));
        printf("Factorial with recursion    = %llu\n", rfact(n));
    }
    return 0;
} 
