#include <stdio.h>

int main() {
    int y, m, d, start, i;
    int days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    char *months[12] = {"January", "February", "March", "April", "May", "June",
                        "July", "August", "September", "October", "November", "December"};

    printf("Enter year: ");
    scanf("%d", &y);

    if ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0))
        days[1] = 29;

    /* Day of week for 1st January (0 = Sunday, 1 = Monday, ...) */
    start = ((y - 1) * 365 + (y - 1) / 4 - (y - 1) / 100 + (y - 1) / 400 + 1) % 7;

    for (m = 0; m < 12; m++) {
        printf("\n\n------------- %s %d -------------\n", months[m], y);
        printf(" Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        for (i = 0; i < start; i++)
            printf("     ");

        for (d = 1; d <= days[m]; d++) {
            printf("%4d ", d);
            if ((d + start) % 7 == 0)
                printf("\n");
        }
        start = (start + days[m]) % 7;
    }
    printf("\n");
    return 0;
}
